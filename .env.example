# 律衡 LexScale 环境变量配置示例
# 复制为 .env 并填入实际值

# ─── LLM 配置 ──────────────────────────────────────────
# OpenAI 兼容 API Key（支持 OpenAI / DeepSeek / GLM / Kimi / Qwen / MiniMax）
LEXSCALE_LLM_API_KEY=sk-your-actual-key-here

# API 端点（默认 OpenAI，可替换为其他兼容服务）
LEXSCALE_LLM_BASE_URL=https://api.openai.com/v1

# 模型选择
# Counsel（主办律师）：需要强推理能力，推荐大模型
LEXSCALE_COUNSEL_MODEL=gpt-4

# Worker（检索/分析/验证/起草/评估）：可以用小模型省钱
LEXSCALE_SMALL_MODEL=gpt-3.5-turbo

# ─── 数据库 ────────────────────────────────────────────
LEXSCALE_DB_HOST=localhost
LEXSCALE_DB_PORT=5432
LEXSCALE_DB_USER=lexscale
LEXSCALE_DB_PASSWORD=your-secure-password
LEXSCALE_DB_NAME=lexscale
LEXSCALE_DB_SSLMODE=disable

# ─── Redis（缓存/会话）─────────────────────────────────
LEXSCALE_REDIS_HOST=localhost
LEXSCALE_REDIS_PORT=6379
LEXSCALE_REDIS_PASSWORD=
LEXSCALE_REDIS_DB=0

# ─── 服务配置 ──────────────────────────────────────────
LEXSCALE_PORT=8080
LEXSCALE_ENV=development
LEXSCALE_LOG_LEVEL=debug

# ─── 认证 ──────────────────────────────────────────────
# API Bearer Token（生产环境必须设置强随机值）
LEXSCALE_AUTH_TOKEN=your-random-auth-token-min-32-chars

# ─── 安全 ──────────────────────────────────────────────
# 一键放行自动过期时间（小时），0 = 永不过期（不推荐）
LEXSCALE_AUTO_ALLOW_EXPIRY=24
